<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Gatekeeper.ForgeExpansion.Linux</AssemblyName><Version>0.15.4</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LinuxBundle)' == 'true'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Manager.Core/Manager.Core.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(LinuxBundle)' == 'true'">
    <EmbeddedResource Include="../../packages/portable-payload.zip" LogicalName="Gatekeeper.ModManager.Payload.zip" />
  </ItemGroup>
</Project>
